# Copy this file to .env and replace every placeholder. Never commit .env.
Discord__Token=replace-with-the-discord-bot-token
Discord__GuildId=replace-with-server-id
Discord__AnnouncementChannelId=replace-with-channel-id
Discord__ManagerRoleId=replace-with-manager-role-id

# Where the SQLite database lives on the host. Leave unset to use the
# steam-update-bot-data named Docker volume. On Unraid, prefer an appdata bind
# mount so the database is covered by appdata backups and survives a Docker
# vDisk rebuild. Create and chown it to uid 1654 before the first start:
#   mkdir -p /mnt/user/appdata/steam-update-bot/data
#   chown -R 1654:1654 /mnt/user/appdata/steam-update-bot/data
# BOT_DATA_PATH=/mnt/user/appdata/steam-update-bot/data

# Published image tag. Default is latest from GHCR.
# IMAGE_TAG=latest

# Host port binding for health probes (default: 127.0.0.1:8080).
# Change if port 8080 is already in use on your host (e.g. 127.0.0.1:8088).
# BOT_PORT=127.0.0.1:8080

# Optional overrides. Defaults: every 5 minutes, max 4 concurrent polls, max 50 games.
# Steam__PollIntervalMinutes=5
# Steam__MaxConcurrentPolls=4
# Steam__MaxGames=50
# Steam__OverlapHours=24
# Steam__RequestTimeoutSeconds=15
