{
  "ConnectionStrings": {
    "BotDb": "Data Source=steam-update-bot.db"
  },
  "Steam": {
    "PollIntervalMinutes": 5,
    "MaxConcurrentPolls": 4,
    "MaxGames": 50,
    "OverlapHours": 24,
    "RequestTimeoutSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
